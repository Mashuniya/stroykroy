<?php

/**
 * @file
 * Конфигуратор лекал на странице товара.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\stroykroy_shop\Setup;

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_product.
 */
function stroykroy_shop_commerce_product_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($view_mode !== 'full' || $entity->bundle() !== Setup::BUNDLE) {
    return;
  }
  $model = (string) $entity->get('field_catalog_id')->value;
  if ($model === '') {
    return;
  }
  $build['stroykroy_configurator'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => ['id' => 'sk-configurator', 'class' => ['sk-configurator']],
    '#value' => 'Загружаем конфигуратор…',
    '#weight' => 2,
    '#attached' => [
      'library' => ['stroykroy_shop/configurator'],
      'drupalSettings' => ['stroykroyShop' => ['model' => $model, 'api' => '/sk-api/api/preview']],
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function stroykroy_shop_mail($key, &$message, $params) {
  if ($key === 'build_error') {
    $message['subject'] = 'Ошибка построения лекал: ' . ($params['name'] ?: $params['model']);
    $message['body'][] = $params['body'];
  }
}

/**
 * Implements hook_form_alter(): форма «В корзину» получает выбор из конфигуратора.
 */
function stroykroy_shop_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if (strpos($form_id, 'commerce_order_item_add_to_cart_form_commerce_product_') !== 0) {
    return;
  }
  $form['sk_selection'] = ['#type' => 'hidden', '#attributes' => ['data-sk-selection' => '1']];
  $form['#validate'][] = 'stroykroy_shop_add_to_cart_validate';
  if (isset($form['actions']['submit']['#submit'])) {
    array_unshift($form['actions']['submit']['#submit'], 'stroykroy_shop_add_to_cart_submit');
  }
}

/**
 * Проверяем выбор покупателя сервисом чертежей до добавления в корзину.
 */
function stroykroy_shop_add_to_cart_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $item = $form_state->getFormObject()->getEntity();
  $variation = $item->getPurchasedEntity();
  $product = $variation ? $variation->getProduct() : NULL;
  if (!$product || $product->bundle() !== Setup::BUNDLE) {
    return;
  }
  $model = (string) $product->get('field_catalog_id')->value;
  $raw = (string) $form_state->getValue('sk_selection');
  $selection = json_decode($raw, TRUE);
  if ($model === '' || !is_array($selection)) {
    $form_state->setErrorByName('sk_selection', t('Не удалось определить выбранные параметры. Обновите страницу и попробуйте ещё раз.'));
    return;
  }
  $checked = \Drupal::service('stroykroy_shop.selection_checker')->check($model, $selection);
  if (!$checked) {
    $form_state->setErrorByName('sk_selection', t('Не удалось построить чертёж для выбранных параметров. Мы уже знаем об ошибке и исправляем её. Попробуйте другие параметры или загляните позже.'));
    return;
  }
  $record = json_encode(['model' => $model, 'selection' => $checked['selection'], 'summary' => $checked['summary']], JSON_UNESCAPED_UNICODE);
  // Ровно такие же лекала уже лежат в корзине — второй раз добавлять незачем
  foreach ($product->getStores() as $store) {
    $cart = \Drupal::service('commerce_cart.cart_provider')->getCart('default', $store);
    foreach ($cart ? $cart->getItems() : [] as $existing) {
      if ($existing->hasField('field_sk_selection') && (string) $existing->get('field_sk_selection')->value === $record
        && (int) $existing->getPurchasedEntityId() === (int) $variation->id()) {
        $form_state->setErrorByName('sk_selection', t('Лекала с такими параметрами уже в корзине.'));
        return;
      }
    }
  }
  $form_state->set('sk_checked', ['model' => $model] + $checked);
}

/**
 * Сохраняем проверенный выбор в позиции заказа и пишем его в название позиции.
 */
function stroykroy_shop_add_to_cart_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $c = $form_state->get('sk_checked');
  if (!$c) {
    return;
  }
  $item = $form_state->getFormObject()->getEntity();
  $item->set('field_sk_selection', json_encode(['model' => $c['model'], 'selection' => $c['selection'], 'summary' => $c['summary']], JSON_UNESCAPED_UNICODE));
  $title = $item->getTitle();
  $item->setTitle($title . ' (' . $c['summary'] . ')');
}
