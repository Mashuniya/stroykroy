<?php

/**
 * @file
 * Конфигуратор лекал на странице товара.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\stroykroy_shop\Setup;

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_product.
 */
function stroykroy_shop_commerce_product_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($view_mode !== 'full' || $entity->bundle() !== Setup::BUNDLE) {
    return;
  }
  $model = (string) $entity->get('field_catalog_id')->value;
  if ($model === '') {
    return;
  }
  // Фото элементов (рукав и т. п.): при выборе элемента галерея показывает их вместо фото основы
  $elementPhotos = [];
  $payload = json_decode((string) $entity->get('field_payload')->value, TRUE);
  $style = \Drupal\image\Entity\ImageStyle::load('large');
  foreach ((array) ($payload['elementPhotos'] ?? []) as $kind => $byId) {
    foreach ((array) $byId as $eid => $uris) {
      foreach ((array) $uris as $uri) {
        $elementPhotos[$kind][$eid][] = $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri);
      }
    }
  }
  // Технические рисунки слоями: основа + рисунки элементов (PNG без обработки стилями)
  $gen = \Drupal::service('file_url_generator');
  $sketch = NULL;
  if (!empty($payload['sketch']['uri'])) {
    $sketch = $payload['sketch'];
    $sketch['src'] = $gen->generateString($sketch['uri']);
    unset($sketch['uri']);
  }
  $elementSketches = [];
  foreach ((array) ($payload['elementSketches'] ?? []) as $kind => $byId) {
    foreach ((array) $byId as $eid => $sk) {
      $sk['src'] = $gen->generateString($sk['uri']);
      unset($sk['uri']);
      $elementSketches[$kind][$eid] = $sk;
    }
  }
  $build['stroykroy_configurator'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => ['id' => 'sk-configurator', 'class' => ['sk-configurator']],
    '#value' => 'Загружаем конфигуратор…',
    '#weight' => 2,
    '#attached' => [
      'library' => ['stroykroy_shop/configurator'],
      'drupalSettings' => ['stroykroyShop' => ['model' => $model, 'api' => '/sk-api/api/preview', 'elementPhotos' => $elementPhotos ?: new \stdClass(), 'sketch' => $sketch, 'elementSketches' => $elementSketches ?: new \stdClass()]],
    ],
  ];
}

/**
 * Implements hook_preprocess_page_title(): на странице лекал вместо названия показываем артикул.
 */
function stroykroy_shop_preprocess_page_title(&$variables) {
  if ($sku = _stroykroy_shop_page_sku()) {
    $variables['title'] = ['#markup' => 'Артикул ' . \Drupal\Component\Utility\Html::escape($sku)];
  }
}

/**
 * Implements hook_preprocess_html(): то же в заголовке вкладки браузера.
 */
function stroykroy_shop_preprocess_html(&$variables) {
  if ($sku = _stroykroy_shop_page_sku()) {
    $variables['head_title']['title'] = 'Артикул ' . $sku;
  }
}

/** Артикул лекал, если открыта страница товара «Лекала»; иначе пустая строка. */
function _stroykroy_shop_page_sku(): string {
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() !== 'entity.commerce_product.canonical') {
    return '';
  }
  $product = $route->getParameter('commerce_product');
  if (!$product || $product->bundle() !== Setup::BUNDLE) {
    return '';
  }
  $variation = $product->getDefaultVariation();
  return $variation ? (string) $variation->getSku() : '';
}

/**
 * Implements hook_form_alter() для оформления заказа: без согласия с условиями заказ не оформляется.
 */
function stroykroy_shop_form_commerce_checkout_flow_multistep_default_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $step = $form['#step_id'] ?? '';
  // Согласие спрашиваем на последнем шаге перед оплатой: «Проверка» (review), а если её нет в схеме — на странице данных заказа
  $steps = [];
  $obj = $form_state->getFormObject();
  if (is_object($obj) && method_exists($obj, 'getPlugin')) {
    $steps = array_keys($obj->getPlugin()->getSteps());
  }
  $target = in_array('review', $steps, TRUE) ? 'review' : 'order_information';
  if ($step !== '' && $step !== $target) {
    return;
  }
  $form['stroykroy_terms'] = [
    '#type' => 'checkbox',
    '#title' => t('Я принимаю условия <a href="@oferta" target="_blank">договора-оферты</a>, <a href="@privacy" target="_blank">политики конфиденциальности</a> и <a href="@terms" target="_blank">условий использования сайта</a>', [
      '@oferta' => '/oferta', '@privacy' => '/privacy', '@terms' => '/terms_and_conditions',
    ]),
    '#required' => TRUE,
    '#required_error' => t('Чтобы оформить заказ, нужно принять условия договора-оферты, политики конфиденциальности и условий использования сайта.'),
    '#weight' => 90,
    '#attributes' => ['class' => ['sk-terms']],
  ];
  $form['#validate'][] = 'stroykroy_shop_checkout_terms_validate';
  if (isset($form['actions'])) {
    $form['actions']['#weight'] = 100;
  }
}

/** Сообщение, если галочка не поставлена, и отметка о согласии в заказе. */
function stroykroy_shop_checkout_terms_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $triggering = $form_state->getTriggeringElement();
  // «Назад» не проверяем
  if (!empty($triggering['#limit_validation_errors']) && $triggering['#limit_validation_errors'] === []) {
    return;
  }
  if (!$form_state->getValue('stroykroy_terms')) {
    $form_state->setErrorByName('stroykroy_terms', t('Чтобы оформить заказ, нужно принять условия договора-оферты, политики конфиденциальности и условий использования сайта.'));
    return;
  }
  $obj = $form_state->getFormObject();
  if (is_object($obj) && method_exists($obj, 'getOrder')) {
    $obj->getOrder()->setData('stroykroy_terms_accepted', \Drupal::time()->getRequestTime());
  }
}

/**
 * Implements hook_mail().
 */
function stroykroy_shop_mail($key, &$message, $params) {
  if ($key === 'build_error') {
    $message['subject'] = 'Ошибка построения лекал: ' . ($params['name'] ?: $params['model']);
    $message['body'][] = $params['body'];
  }
}

/**
 * Implements hook_form_alter(): форма «В корзину» получает выбор из конфигуратора.
 */
function stroykroy_shop_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if (strpos($form_id, 'commerce_order_item_add_to_cart_form_commerce_product_') !== 0) {
    return;
  }
  $form['sk_selection'] = ['#type' => 'hidden', '#attributes' => ['data-sk-selection' => '1']];
  $form['#validate'][] = 'stroykroy_shop_add_to_cart_validate';
  if (isset($form['actions']['submit']['#submit'])) {
    array_unshift($form['actions']['submit']['#submit'], 'stroykroy_shop_add_to_cart_submit');
  }
}

/**
 * Проверяем выбор покупателя сервисом чертежей до добавления в корзину.
 */
function stroykroy_shop_add_to_cart_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $item = $form_state->getFormObject()->getEntity();
  $variation = $item->getPurchasedEntity();
  $product = $variation ? $variation->getProduct() : NULL;
  if (!$product || $product->bundle() !== Setup::BUNDLE) {
    return;
  }
  $model = (string) $product->get('field_catalog_id')->value;
  $raw = (string) $form_state->getValue('sk_selection');
  $selection = json_decode($raw, TRUE);
  if ($model === '' || !is_array($selection)) {
    $form_state->setErrorByName('sk_selection', t('Не удалось определить выбранные параметры. Обновите страницу и попробуйте ещё раз.'));
    return;
  }
  $checked = \Drupal::service('stroykroy_shop.selection_checker')->check($model, $selection);
  if (!$checked) {
    $form_state->setErrorByName('sk_selection', t('Не удалось построить чертёж для выбранных параметров. Мы уже знаем об ошибке и исправляем её. Попробуйте другие параметры или загляните позже.'));
    return;
  }
  $record = json_encode(['model' => $model, 'selection' => $checked['selection'], 'summary' => $checked['summary']], JSON_UNESCAPED_UNICODE);
  // Ровно такие же лекала уже лежат в корзине — второй раз добавлять незачем
  foreach ($product->getStores() as $store) {
    $cart = \Drupal::service('commerce_cart.cart_provider')->getCart('default', $store);
    foreach ($cart ? $cart->getItems() : [] as $existing) {
      if ($existing->hasField('field_sk_selection') && (string) $existing->get('field_sk_selection')->value === $record
        && (int) $existing->getPurchasedEntityId() === (int) $variation->id()) {
        $form_state->setErrorByName('sk_selection', t('Лекала с такими параметрами уже в корзине.'));
        return;
      }
    }
  }
  $form_state->set('sk_checked', ['model' => $model] + $checked);
}

/**
 * Сохраняем проверенный выбор в позиции заказа и пишем его в название позиции.
 */
function stroykroy_shop_add_to_cart_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $c = $form_state->get('sk_checked');
  if (!$c) {
    return;
  }
  $item = $form_state->getFormObject()->getEntity();
  $item->set('field_sk_selection', json_encode(['model' => $c['model'], 'selection' => $c['selection'], 'summary' => $c['summary']], JSON_UNESCAPED_UNICODE));
  $title = $item->getTitle();
  $item->setTitle($title . ' (' . $c['summary'] . ')');
}

/**
 * Implements hook_preprocess_views_view_field(): под названием лекал в корзине и в заказе — выбранные параметры.
 */
function stroykroy_shop_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];
  // Список «Мои заказы»: статус по-русски и ссылка на скачивание лекал
  if ((string) $view->id() === 'commerce_user_orders' && ($variables['field']->options['id'] ?? '') === 'state') {
    $order = $variables['row']->_entity ?? NULL;
    if ($order instanceof \Drupal\commerce_order\Entity\OrderInterface) {
      $states = [
        'draft' => 'Черновик', 'validation' => 'Проверяется', 'fulfillment' => 'Выполняется',
        'completed' => 'Оплачен', 'canceled' => 'Отменён',
      ];
      $id = (string) $order->getState()->getId();
      $html = \Drupal\Component\Utility\Html::escape($states[$id] ?? (string) $variables['output']);
      if ($id === 'completed') {
        $url = \Drupal\Core\Url::fromRoute('stroykroy_shop.order_files', ['commerce_order' => $order->id()], [
          'query' => ['t' => \Drupal\stroykroy_shop\OrderFiles::token('order|' . $order->id())],
        ])->toString();
        $html .= '<div style="margin-top:4px"><a href="' . \Drupal\Component\Utility\Html::escape($url) . '">Скачать лекала</a></div>';
      }
      $variables['output'] = \Drupal\Core\Render\Markup::create($html);
    }
    return;
  }
  if (strpos((string) $view->id(), 'commerce_cart') !== 0 && strpos((string) $view->id(), 'commerce_checkout') !== 0) {
    return;
  }
  // Подпись добавляем к названию товара
  if (!in_array($variables['field']->options['id'] ?? '', ['title', 'purchased_entity'], TRUE)) {
    return;
  }
  // В корзине строка — это заказ со связью на позицию, в сводке заказа — сама позиция
  $row = $variables['row'];
  $item = $row->_entity ?? NULL;
  if (!$item instanceof \Drupal\commerce_order\Entity\OrderItemInterface) {
    $item = $row->_relationship_entities['order_items'] ?? NULL;
  }
  if (!$item instanceof \Drupal\commerce_order\Entity\OrderItemInterface || !$item->hasField('field_sk_selection') || $item->get('field_sk_selection')->isEmpty()) {
    return;
  }
  $saved = json_decode((string) $item->get('field_sk_selection')->value, TRUE);
  if (empty($saved['summary'])) {
    return;
  }
  $variation = $item->getPurchasedEntity();
  $sku = $variation ? (string) $variation->getSku() : '';
  $text = ($sku !== '' ? 'Артикул ' . $sku . ' · ' : '') . $saved['summary'];
  $variables['output'] = \Drupal\Core\Render\Markup::create(
    $variables['output'] . '<div class="sk-cart-note" style="font-size:13px;color:#666;margin-top:4px">' . \Drupal\Component\Utility\Html::escape($text) . '</div>'
  );
}
