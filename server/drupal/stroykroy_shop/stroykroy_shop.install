<?php

/**
 * @file
 * Установка модуля «СтройКрой — магазин лекал».
 */

/**
 * Implements hook_install().
 *
 * Создаёт тип товара «Лекала», поля и валюту. Всё можно запускать повторно:
 * то, что уже есть, пропускается.
 */
function stroykroy_shop_install() {
  \Drupal::service('stroykroy_shop.setup')->run();
}

/**
 * Страницы «О нас», «Контакты», «Договор-оферта», «Политика», «Условия использования» по образцу старого сайта.
 *
 * Тексты существующих страниц заменяются на актуальные (адреса как на lekala62.ru: /o_nas, /kontakty, /oferta, /privacy, /terms_and_conditions).
 */
function stroykroy_shop_update_10001() {
  (new \Drupal\stroykroy_shop\StorePages())->sync(TRUE);
}
