{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stroykroy-studio",
  "version": "0.1.0",
  "identifier": "ru.stroykroy.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "СтройКрой — студия разработчика",
        "width": 1280,
        "height": 860
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
